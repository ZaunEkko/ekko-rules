# Reachable from this computer and its trusted LAN, like common Docker services.
# Set 127.0.0.1 only when you explicitly want host-only access.
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8787
# Optional advertised origin, for example: http://192.168.1.100:8787
# Leave empty to use the address that opened the Web UI.
LAN_BASE_URL=
EKKO_RULES_VERSION=local
SUBCONVERTER_VERSION=v1.3.0
CONVERT_TIMEOUT_MS=30000
MAX_SUBSCRIPTION_BYTES=5242880
# Optional management password for creating, listing, and deleting profiles.
ACCESS_PASSWORD=
# Comma-separated hostnames allowed even if they resolve privately.
# Keep empty for normal personal use. E2E may set: fixture
CONVERT_ALLOW_HOSTNAMES=
