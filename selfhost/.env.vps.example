# Open converter deployment. Copy to .env on the server and edit.
#
#   cp .env.vps.example .env
#   docker compose up --build -d
#
# The service listens on 127.0.0.1 only; an existing reverse proxy terminates
# TLS and forwards to it. See nginx/sub.example.com.conf.

# public = an open converter that stores nothing. The personal, stored-address
# shape (SELFHOST_MODE=lan) is meant for your own computer, not a server.
SELFHOST_MODE=public

# Only the reverse proxy faces the internet. Keep the app port on loopback.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8787

# Canonical origin: used for health output and as the fallback prefix.
PUBLIC_BASE_URL=https://sub.example.com

# Other domains this same deployment answers on, comma separated. Visitors get
# links on whichever domain they opened, so no extra configuration per domain.
PUBLIC_ALT_ORIGINS=

# Ignored in public mode: an open converter has nothing to protect with it.
# It is the optional management guard for SELFHOST_MODE=lan only.
ACCESS_PASSWORD=

# Requests per minute per client IP. 0 disables a limiter.
RATE_LIMIT_MANAGE_PER_MINUTE=30
RATE_LIMIT_SUBSCRIBE_PER_MINUTE=60

# The reverse proxy supplies the real client address, so forwarded headers are
# trusted for rate limiting. Set 0 if nothing fronts this service.
TRUST_PROXY_HEADERS=1

# Remote configs. Ekko Rules is always first and is the default.
# 0 removes the bundled third-party presets (ACL4SSR).
THIRD_PARTY_REMOTE_CONFIGS=1
# 0 stops visitors from pasting their own https config URL.
ALLOW_CUSTOM_REMOTE_CONFIG=1
# Extra presets: [{"id":"mine","label":"My rules","url":"https://..."}]
REMOTE_CONFIGS=

# Published images (compose.ghcr.yaml). Pin a tag to make deploys
# reproducible and rollbacks one edit away; latest follows every release.
EKKO_IMAGE_OWNER=zaunekko
EKKO_IMAGE_TAG=latest

SUBCONVERTER_VERSION=v1.3.0
# 整次转换的总预算（非单次请求）：拉订阅、拉 provider、两次引擎调用共用它。
# 前置反代的读取超时要大于这个值。
CONVERT_TIMEOUT_MS=30000
MAX_SUBSCRIPTION_BYTES=5242880
CONVERT_ALLOW_HOSTNAMES=

# Footer links shown on the page. [] removes the row.
# Omit to use this project own links.
SITE_LINKS=
